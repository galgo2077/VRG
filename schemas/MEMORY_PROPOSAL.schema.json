{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vrg:adaptive-memory:proposal:v1",
  "title": "Propuesta Adaptive Memory v1 — contrato a implementar",
  "description": "Validar estructura no valida verdad, permisos, pertenencia de fuentes ni límites de spans; el motor debe comprobarlos.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "project_id",
    "privacy_scope_id",
    "expected_generation",
    "created_at",
    "producer",
    "operations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "privacy_scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "expected_generation": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "identity"
      ],
      "properties": {
        "kind": {
          "enum": [
            "codex",
            "human"
          ]
        },
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "action",
          "memory_id",
          "sources",
          "reason_code"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "action": {
            "enum": [
              "keep",
              "set_tier",
              "upsert_summary"
            ]
          },
          "memory_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "revision_sha256",
                "span_start",
                "span_end"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "revision_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "span_start": {
                  "type": "integer",
                  "minimum": 0
                },
                "span_end": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "reason_code": {
            "enum": [
              "current_constraint",
              "reusable_solution",
              "active_work",
              "infrequent_but_valid",
              "superseded_history",
              "duplicate_knowledge",
              "uncertain_keep_detail"
            ]
          },
          "target_tier": {
            "enum": [
              "HOT",
              "WARM",
              "COLD"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          },
          "protected_facts": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fact",
                "source_id"
              ],
              "properties": {
                "fact": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 800
                },
                "source_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                }
              }
            }
          },
          "epistemic_state": {
            "enum": [
              "proposed",
              "verified",
              "conflicted",
              "superseded"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "needs_expansion": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "action": {
                  "const": "upsert_summary"
                }
              },
              "required": [
                "action"
              ]
            },
            "then": {
              "required": [
                "summary",
                "protected_facts",
                "epistemic_state",
                "confidence",
                "needs_expansion"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "const": "set_tier"
                }
              },
              "required": [
                "action"
              ]
            },
            "then": {
              "required": [
                "target_tier"
              ]
            }
          }
        ]
      }
    }
  }
}

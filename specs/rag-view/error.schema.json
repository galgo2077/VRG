{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vrg:rag-view:error:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "error"
  ],
  "properties": {
    "api_version": {
      "const": "rag-view-v1"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable",
        "request_id"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "request_id": {
          "type": "string"
        }
      }
    }
  }
}
